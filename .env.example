# Production
REDIS_PASSWORD=replace-with-a-long-random-base64url-secret
CORS_ORIGIN=https://your-domain.example
NEXT_PUBLIC_API_URL=https://api.your-domain.example
WEB_PORT=3000
API_PORT=4000
TRUST_PROXY=1

# Build service
WORKER_CONCURRENCY=1
MAX_QUEUED_BUILDS=3
BUILD_RATE_LIMIT=5
STATUS_RATE_LIMIT=120
ARTIFACT_TTL_MS=86400000
CLEANUP_INTERVAL_MS=3600000
